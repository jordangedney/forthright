include lib/prelude.fr			\ depends on: prelude (syscall3)

\ io.fr — files, via raw syscalls. fds are plain ints. Paths passed to open-r/open-w
\ must be NUL-terminated (use `zpath` to copy an addr/len string + a terminator).
\ read-fd/write-fd return the byte count (or a negative errno).

0 constant STDIN   1 constant STDOUT   2 constant STDERR
variable zpathbuf  256 allot		\ scratch for NUL-terminated paths
variable zb        8 allot		\ 1-byte scratch for emit-fd

: open-r  ( zaddr -- fd )    0 0 2 syscall3 ;		\ open(path, O_RDONLY)
: open-w  ( zaddr -- fd )    577 420 2 syscall3 ;	\ open(path, O_WRONLY|O_CREAT|O_TRUNC, 0644)
: close-fd ( fd -- )         0 0 3 syscall3 drop ;	\ close(fd)
: read-fd  ( fd buf n -- got )   0 syscall3 ;		\ read(fd, buf, n)
: write-fd ( fd buf n -- got )   1 syscall3 ;		\ write(fd, buf, n)
: dup2     ( old new -- )    0 0 0 0 33 syscall6 drop ;	\ dup2(old, new)
: emit-fd  ( c fd -- )       swap zb !  zb 1 write-fd drop ;	\ write one byte to fd

: zpath   ( addr len -- zaddr )		\ copy a string + a NUL into zpathbuf; return it
  >r  zpathbuf r@ cmove			\ copy len bytes:  cmove( addr, zpathbuf, len )
  0 zpathbuf r> + c!			\ NUL-terminate at zpathbuf[len]
  zpathbuf ;
