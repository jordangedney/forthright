include lib/tui.fr			\ draw, key, term, math, prelude
include lib/time.fr			\ now-ms — wall clock for gravity
include lib/random.fr			\ random% — which piece comes next

\ tetris.fr — a playable Tetris, written in fr on the lib.   ./fr examples/tetris.fr
\ Controls: ← → move · ↑ rotate · ↓ soft-drop · space hard-drop · q quit.
\ (Letters h l k j also work, for terminals where arrows misbehave.)  Needs ~24 rows.

\ ===== the board =====================================================
10 constant COLS   20 constant ROWS
variable board   COLS ROWS *  allot		\ one byte per cell: 0 empty, 1..7 = piece colour
: cell  ( r c -- a )  swap COLS * +  board + ;
: cell@ ( r c -- v )  cell c@ ;
: cell! ( v r c -- )  cell c! ;
: clear-board ( -- )  board  COLS ROWS *  0 fill ;

\ ===== the 7 pieces: 4 blocks each, (row,col) in a 4x4 box ===========
variable pbase   here pbase !			\ the table lives right here in the dictionary
1 , 0 ,   1 , 1 ,   1 , 2 ,   1 , 3 ,		\ 0  I
1 , 1 ,   1 , 2 ,   2 , 1 ,   2 , 2 ,		\ 1  O
1 , 0 ,   1 , 1 ,   1 , 2 ,   2 , 1 ,		\ 2  T
1 , 1 ,   1 , 2 ,   2 , 0 ,   2 , 1 ,		\ 3  S
1 , 0 ,   1 , 1 ,   2 , 1 ,   2 , 2 ,		\ 4  Z
1 , 0 ,   2 , 0 ,   2 , 1 ,   2 , 2 ,		\ 5  J
1 , 2 ,   2 , 0 ,   2 , 1 ,   2 , 2 ,		\ 6  L
: pblock ( i j -- r c )  2 *  swap 8 *  +  cells  pbase @ +  dup @  swap cell+ @ ;

\ ===== the current piece =============================================
variable cur-type  variable cur-rot  variable cur-row  variable cur-col
: rot1 ( r c -- c 3-r )  swap  3 swap - ;	\ rotate a cell 90° CW inside the 4x4 box
: rotate ( r c n -- r' c' )  0 do  rot1  loop ;	\ apply the CW rotation n times
: cur-block ( j -- br bc )			\ board (row,col) of the current piece's block j
  cur-type @ swap pblock  cur-rot @ rotate
  swap cur-row @ +  swap cur-col @ + ;

\ ===== collision, movement, rotation =================================
: collides? ( -- f )				\ does the current piece overlap a wall/floor/block?
  4 0 do
    i cur-block					( br bc )
    dup 0 <      if 2drop -1 unloop exit then	\ off the left
    dup COLS >=  if 2drop -1 unloop exit then	\ off the right
    over ROWS >= if 2drop -1 unloop exit then	\ through the floor
    over 0 >= if  2dup cell@  if 2drop -1 unloop exit then  then	\ onto a settled block
    2drop
  loop  0 ;
variable svr  variable svc
: try-move ( dr dc -- f )			\ shift the piece; undo + return 0 if it can't go
  cur-row @ svr !  cur-col @ svc !
  cur-col @ + cur-col !   cur-row @ + cur-row !
  collides? if  svr @ cur-row !  svc @ cur-col !  0  else  -1  then ;
: try-rot ( -- f )				\ rotate; undo + return 0 if it can't
  cur-rot @  cur-rot @ 1+ 3 and cur-rot !
  collides? if  cur-rot !  0  else  drop -1  then ;

\ ===== locking + clearing full lines =================================
: lock-piece ( -- )				\ stamp the piece into the board
  4 0 do
    i cur-block					( br bc )
    over 0 >= if  cur-type @ 1+  rot rot  cell!  else  2drop  then
  loop ;
: row-full? ( r -- f )				\ r stays on the data stack; i is the column
  COLS 0 do  dup i cell@ 0= if  drop 0 unloop exit  then  loop  drop -1 ;
variable cf  variable ct
: copy-row ( from to -- )  ct ! cf !
  COLS 0 do  cf @ i cell@   ct @ i cell!  loop ;
variable crr					\ (this shift is descending, so it stays a begin/while)
: clear-row ( r -- )				\ delete row r: drop everything above it down one
  crr !
  begin  crr @ 0 >  while  crr @ 1-  crr @  copy-row  crr @ 1- crr !  repeat
  COLS 0 do  0  0 i cell!  loop ;		\ blank the new top row
variable clr  variable cln
: clear-lines ( -- n )				\ clear every full row, return how many
  0 cln !  ROWS 1- clr !
  begin  clr @ 0 >=  while
    clr @ row-full? if  clr @ clear-row  cln @ 1+ cln !  else  clr @ 1- clr !  then
  repeat  cln @ ;

\ ===== spawning + gravity ============================================
variable score  variable gameover
: spawn ( -- )
  7 random% cur-type !  0 cur-rot !  0 cur-row !  3 cur-col !
  collides? if  -1 gameover !  then ;		\ can't even place it -> game over
: gravity ( -- )				\ one downward step (or lock + clear + respawn)
  1 0 try-move 0= if
    lock-piece
    clear-lines  dup *  100 *  score +!		\ n cleared -> +100·n²
    spawn
  then ;
: hard-drop ( -- )  begin  1 0 try-move  while  repeat  gravity ;

\ ===== rendering =====================================================
2 constant BT   4 constant BL			\ board's top-left screen cell (row, col)
: blk ( -- )  226 150 136 u8  226 150 136 u8 ;	\ "██" — a cell is two columns wide
: pcolour ( v -- )				\ fg colour for piece value 1..7
  dup 1 = if drop nord-cyan   else
  dup 2 = if drop nord-yellow else
  dup 3 = if drop nord-purple else
  dup 4 = if drop nord-green  else
  dup 5 = if drop nord-orange else
  dup 6 = if drop nord-frost  else
  drop nord-fg  then then then then then then ;
: paint ( r c v -- )				\ draw one cell at its screen position
  >r  swap BT +  swap 2 * BL +  at		\ at( BT+r, BL+2c )
  r> dup 0= if  drop space space  else  pcolour blk reset  then ;
: draw-grid ( -- )				\ j = row, i = col
  ROWS 0 do  COLS 0 do
    j i  j i cell@  paint
  loop loop ;
: draw-piece ( -- )				\ overlay the live piece on top of the grid
  4 0 do
    i cur-block  over 0 >= if  cur-type @ 1+  paint  else  2drop  then
  loop ;
: draw ( -- )
  1 3  COLS 2 * 2 +  ROWS 2 +  s" forthright tetris" panel
  draw-grid  draw-piece
  3  BL COLS 2 * + 6 +  at  nord-fg ." score" reset
  4  BL COLS 2 * + 6 +  at  score @ u.
  ROWS BT + 2 +  1 at ;				\ park the cursor below the board

\ ===== input + the game loop =========================================
\ Input is the lib's `getkey` (arrows -> KEY-*): it composes with our timed poll, so it
\ returns -1 when no key arrives within the interval (letting gravity tick).
: handle ( key -- )
  dup KEY-LEFT  = over [char] h = or if  drop  0 -1 try-move drop  exit  then
  dup KEY-RIGHT = over [char] l = or if  drop  0  1 try-move drop  exit  then
  dup KEY-DOWN  = over [char] j = or if  drop  1  0 try-move drop  exit  then
  dup KEY-UP    = over [char] k = or if  drop  try-rot drop        exit  then
  dup 32 =                          if  drop  hard-drop            exit  then
  dup [char] q =                    if  drop  -1 gameover !        exit  then
  drop ;
variable last-ms
: tetris ( -- )
  raw-on  hide-cursor  clear
  now-ms seed!  clear-board  0 score !  0 gameover !  spawn
  1 raw-timed  now-ms last-ms !			\ ~100ms key timeout; gravity off the wall clock
  begin
    draw
    getkey  dup -1 = if  drop  else  handle  then
    now-ms last-ms @ -  500 >= if  gravity  now-ms last-ms !  then
    gameover @
  until
  raw-poll  show-cursor  reset  raw-off
  clear  ." game over — score "  score @ u.  cr  bye ;

tetris
