\ ember.fr — the self-hosted explorer: a visual stepper driving the REAL fr engine
\ under ptrace. It forks fr, runs a word in the child, and single-steps the child to
\ each `jmp *(%rax)` dispatch boundary, reading the child's real registers and data
\ stack. (For a lighter, no-ptrace text stepper, the prelude's `trace` models it.)
\
\     ./fr prelude.fr term.fr ptrace.fr ember.fr      then type:  5 ' square ember
\     ./ember-fr ["5 ' square ember"]                  shell launcher (pre-runs a command;
\                                                       no arg = the default `5 ' square ember`)
\
\ Panels (a Nord-coloured, bordered dashboard):
\   call — the live call path (e.g. cube > square), inferred from the dispatch stream.
\   code — the current word's body, the live cell (%rsi-8) highlighted.
\   data — the real data stack, peeked out of the child with PTRACE_PEEKDATA.
\ Keys: space/s = step · r = run to end · e = edit (type a new target) · q/Esc = quit.
\
\ Forking (not exec) shares fr's memory image, so the parent decodes the child's CFAs
\ and reads its body / stack base (sp0) for free. Depends on prelude.fr term.fr ptrace.fr.

9 constant SIGKILL
variable alive       \ -1 while the traced child is stopped & steppable
variable lsteps      \ dispatch boundaries advanced through
variable etop        \ CFA of the top-level word being stepped (for the title / re-run)

\ --- live call tracking ------------------------------------------------------
\ We can't see the engine's docol frames directly, so we infer them from the dispatch
\ stream: a CFA whose codeword is `docol` enters a colon word; `EXIT` returns. lcur =
\ the word we're inside; lcstk = the enclosing words.
variable lcur                       \ CFA of the word we're currently inside (0 = none)
variable lcstk  32 cells allot  variable lcn
: lcpush ( a -- )  lcstk lcn @ cells + !  lcn @ 1+ lcn ! ;
: lcpop  ( -- a )  lcn @ 1- lcn !  lcstk lcn @ cells + @ ;
: l-track ( -- )
  r-rax 'exit = if
    lcn @ 0= if  0 lcur !  else  lcpop lcur !  then  exit  then
  r-rax @ 'docol = if
    lcur @ if  lcur @ lcpush  then   r-rax lcur !  then ;
: l-step ( -- )                     \ single-step to the next dispatch boundary (or child death)
  begin
    child @ ssstep  pwait  stopped? 0= if  0 alive !  exit  then
    child @ getregs  dispatch?
  until
  l-track  lsteps @ 1+ lsteps ! ;
: erun ( -- )  begin  alive @  while  l-step  repeat ;   \ run the traced word to completion

\ --- panels ------------------------------------------------------------------
variable lsj  variable ldepth
: .lstack ( -- )                    \ the child's live data stack (bottom..top), peeked
  sp0 r-rsp -  8 /  ldepth !
  1 lsj !
  begin  lsj @ ldepth @ 1+ <  while
    child @  sp0 lsj @ cells -  peekdata  .n space
    lsj @ 1+ lsj !
  repeat ;
variable lci
: draw-call ( -- )                  \ the live call path (enclosing words, then the current)
  lcur @ 0= if  exit  then
  0 lci !
  begin  lci @ lcn @ <  while
    nord-purple lcstk lci @ cells + @  .cfaname  reset  space [char] > emit space
    lci @ 1+ lci !
  repeat
  nord-purple bold  lcur @ .cfaname  reset ;
variable ldp
: ltok ( -- )                       \ one cell of the current word's body
  ldp @  r-rsi 8 -  = if  nord-yellow bold  then   \ highlight the live current cell
  ldp @ @
  dup 'exit    = if  drop [char] ; emit                                      ldp @ 8 +  ldp !
  else dup 'lit    = if  drop [char] # emit  ldp @ 8 + @ .n                  ldp @ 16 + ldp !
  else dup 'branch = if  drop [char] b emit space ldp @ 8 + @ .n            ldp @ 16 + ldp !
  else dup '0branch = if  drop [char] 0 emit [char] b emit space ldp @ 8 + @ .n  ldp @ 16 + ldp !
  else  .cfaname                                                            ldp @ 8 +  ldp !
  then then then then
  reset space ;
: draw-code ( -- )
  lcur @ 0= if  exit  then
  lcur @ cell+ ldp !
  begin  ldp @ @ 'exit =  >r  ltok  r>  until ;

\ --- non-interactive trace (pipe-testable): print the live stack at each dispatch ---
\ Proof we're reading the *real* engine: `5 ' square ember-trace` shows the data stack
\ evolve 5 -> 5 5 -> 25, peeked from the child.
: ember-trace ( n cfa -- )
  fork dup 0= if
    drop  traceme  getpid SIGSTOP kill  execute  bye
  else
    child !  2drop
    -1 alive !  0 lsteps !
    pwait drop
    begin  l-step  alive @  while
      r-rax .dispatched  [char] : emit space  .lstack  cr
    repeat
  then ;

\ --- the dashboard -----------------------------------------------------------
58 constant EBW   8 constant EBH               \ box: width, height
variable lquit
: .ember ( -- ) [char] e emit [char] m emit [char] b emit [char] e emit [char] r emit ;
: .real  ( -- ) [char] r emit [char] e emit [char] a emit [char] l emit space
                [char] e emit [char] n emit [char] g emit [char] i emit [char] n emit [char] e emit ;
: .call  ( -- ) [char] c emit [char] a emit [char] l emit [char] l emit ;
: .code  ( -- ) [char] c emit [char] o emit [char] d emit [char] e emit ;
: .data  ( -- ) [char] d emit [char] a emit [char] t emit [char] a emit ;
: .ended ( -- ) [char] e emit [char] x emit [char] i emit [char] t emit [char] e emit [char] d emit ;
: .stepk ( -- ) [char] s emit [char] p emit [char] a emit [char] c emit [char] e emit
                [char] = emit [char] s emit [char] t emit [char] e emit [char] p emit ;
: .runk  ( -- ) [char] r emit [char] = emit [char] r emit [char] u emit [char] n emit ;
: .editk ( -- ) [char] e emit [char] = emit [char] e emit [char] d emit [char] i emit [char] t emit ;
: .quitk ( -- ) [char] q emit [char] = emit [char] q emit [char] u emit [char] i emit [char] t emit ;
: draw ( -- )
  1 1 EBW EBH box
  1 3 at  nord-cyan bold  .ember  [char] : emit space  etop @ .cfaname  reset
          space space  nord-dim [char] # emit  lsteps @ .n  space space  .real reset
  3 3 at  nord-dim .call reset  3 9 at  draw-call
  4 3 at  nord-dim .code reset  4 9 at  alive @ if  draw-code  then
  5 3 at  nord-dim .data reset  5 9 at  alive @ if  nord-orange .lstack reset  else  nord-dim .ended reset  then
  7 3 at  nord-dim .stepk space space .runk space space .editk space space .quitk reset ;

\ --- live edit line (re-fork a child on each re-target) -----------------------
\ `e` reads a line of Forth. Numbers push, words run, and: a line ending in a colon
\ word re-targets to it (the rest is setup); otherwise the line just runs and the
\ current word re-runs on the result. An unknown token flashes `<word> ?`.
variable lbuf  88 allot   variable lblen   variable lp
variable pa  variable pl  variable pf
: clear-stack ( -- )  begin  depth 0 >  while  drop  repeat ;
: lc@    ( -- c )  lbuf lp @ + c@ ;
: lc-ws? ( -- f )  lc@ 32 =  lc@ 9 =  or  lc@ 10 =  or ;
: token  ( -- addr len )                       \ next whitespace-delimited token of lbuf
  begin  lp @ lblen @ <  lc-ws?     and  while  lp @ 1+ lp !  repeat
  lbuf lp @ +  0
  begin  lp @ lblen @ <  lc-ws? 0=  and  while  1+  lp @ 1+ lp !  repeat ;
: last-token ( -- addr len )                   \ the LAST token of lbuf (0 0 if none)
  0 lp !  0 pa !  0 pl !
  begin  token dup  while  pl !  pa !  repeat  2drop  pa @ pl @ ;
: colon? ( addr len -- f )  find  dup if  @ 'docol =  else  drop 0  then ;
: known? ( addr len -- f )  2dup number nip  >r  find  r>  or ;
: setup-token ( addr len -- )                  \ run one token: number push / word execute
  2dup number if  >r 2drop r>
  else  drop  find  dup if  execute  else  drop  then  then ;
: run-all ( -- )  0 lp !  begin  token dup  while  setup-token  repeat  2drop ;
: run-setup ( -- target )                      \ run every token but the last; the last = target
  0 lp !  0 pf !
  begin  token dup  while
    pf @ if  >r >r  pa @ pl @ setup-token  r> r>  then    \ flush prev; keep this token off the stack
    pl !  pa !  -1 pf !
  repeat  2drop
  pf @ if  pa @ pl @ find  else  0  then ;
: read-line ( -- )                             \ read+echo a line into lbuf; Enter ends it
  0 lblen !
  begin
    key
    dup 13 = over 10 = or if  drop  exit  then               \ Enter
    dup 8 = over 127 = or if  drop                           \ backspace
      lblen @ 0 > if  lblen @ 1- lblen !  8 emit space 8 emit  then
    else
      lblen @ 87 < if  dup lbuf lblen @ + c!  lblen @ 1+ lblen !  emit  else drop then
    then
  0 until ;

\ launch — fork a child running execute(cfa) on the args beneath it, and trace it.
: launch ( args cfa -- )
  dup etop !
  fork dup 0= if
    drop  traceme  getpid SIGSTOP kill  execute  bye
  else
    child !  clear-stack                      \ the parent's copy; the child kept its own
    -1 alive !  0 lsteps !  0 lcur !  0 lcn !
    pwait drop
    alive @ if  l-step  then                  \ advance to the first dispatch boundary
  then ;
: kill-child ( -- )  alive @ if  child @ SIGKILL kill  pwait drop  then ;
: eline ( -- )  7 3 at  EBW 5 - spaces  7 3 at ;   \ clear the status row inside the box
: edit-target ( -- )
  eline  [char] > emit space  show-cursor
  read-line  hide-cursor
  last-token  2dup colon? if                    ( addr len )  \ ends in a colon word: step it
    2drop  kill-child  clear-stack  run-setup  launch
  else 2dup known? if                            ( addr len )  \ number/primitive: re-run current
    2drop  kill-child  clear-stack  run-all  etop @  launch
  else                                           ( addr len )  \ unknown: flash, keep current
    eline  nord-yellow  type  space [char] ? emit  reset  key drop
  then then ;

\ --- the event loop ----------------------------------------------------------
: ember ( args cfa -- )                  \ usage:  <args> ' <word> ember
  launch  0 lquit !
  raw-on  hide-cursor  clear              \ clear once; draw then overwrites in place
  begin
    draw
    key                                          ( c )
    dup 0<              if  drop  -1 lquit !
    else dup [char] q = if  drop  -1 lquit !
    else dup 27 =       if  drop  -1 lquit !       \ Esc
    else dup [char] e = if  drop  edit-target      \ type a new target
    else dup [char] r = if  drop  erun             \ run to the end
    else dup [char] s = over 32 = or if  drop  alive @ if  l-step  then
    else drop
    then then then then then then
    lquit @
  until
  kill-child
  show-cursor  reset  raw-off  cr  bye ;
