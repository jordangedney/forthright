\ live.fr — the visual stepper, driving the REAL fr engine under ptrace. Where
\ ember.fr *simulates* stepping (it walks the threaded code itself), this watches the
\ actual engine: it forks fr, runs a word in the child, and single-steps the child from
\ the parent to each `jmp *(%rax)` dispatch boundary. It shows ember.fr's exact view:
\   call — the live call path (e.g. cube > square), tracked by spotting docol-entries
\          and EXITs in the dispatch stream.
\   code — the current word's body, with the live cell (%rsi-8) highlighted.
\   data — the real data stack, peeked straight out of the child with PTRACE_PEEKDATA.
\ This is ember's "NativeVM" backend (the part that lived in Python), now in fr.
\
\     ./fr prelude.fr term.fr ptrace.fr live.fr      then type:  5 ' square live
\     ./ember-fr --live-selftest                     headless pty check
\
\ Forking (not exec) means the child shares fr's memory image, so the parent decodes
\ the child's CFAs (`.cfaname`) and reads the live body/stack base (`sp0`) for free.
\ Depends on prelude.fr, term.fr, ptrace.fr.

9 constant SIGKILL
variable alive       \ -1 while the traced child is still stopped & steppable
variable lsteps      \ how many dispatch boundaries we've advanced through

\ Live call tracking. We can't see the engine's docol frames directly, so we infer
\ them from the dispatch stream: dispatching a CFA whose codeword is `docol` enters a
\ colon word; dispatching `EXIT` returns from one. lcur = the word we're inside;
\ lcstk = the enclosing words (for the call-path panel). The bodies live in the shared
\ (forked) dictionary, so the parent reads/decodes them with plain `@`.
variable lcur                       \ CFA of the word we're currently inside (0 = none)
variable lcstk  32 cells allot  variable lcn
: lcpush ( a -- )  lcstk lcn @ cells + !  lcn @ 1+ lcn ! ;
: lcpop  ( -- a )  lcn @ 1- lcn !  lcstk lcn @ cells + @ ;
: l-track ( -- )                    \ update lcur/lcstk from the just-found dispatch
  r-rax 'exit = if
    lcn @ 0= if  0 lcur !  else  lcpop lcur !  then  exit  then    \ returned
  r-rax @ 'docol = if               \ entering a colon word (its codeword is docol)
    lcur @ if  lcur @ lcpush  then   r-rax lcur !  then ;

\ l-step — single-step the child up to its next dispatch boundary (or note its death).
\ On return, if `alive`, getregs is fresh: r-rax/r-rsi/r-rsp describe the live engine.
: l-step ( -- )
  begin
    child @ ssstep  pwait  stopped? 0= if  0 alive !  exit  then   \ child exited
    child @ getregs  dispatch?
  until
  l-track
  lsteps @ 1+ lsteps ! ;

\ .lstack — the child's live data stack (bottom..top), peeked out of the process.
\ depth = (sp0 - child's %rsp)/8; item j from the bottom is at sp0 - j cells.
variable lsj  variable ldepth
: .lstack ( -- )
  sp0 r-rsp -  8 /  ldepth !
  1 lsj !
  begin  lsj @ ldepth @ 1+ <  while
    child @  sp0 lsj @ cells -  peekdata  .n space
    lsj @ 1+ lsj !
  repeat ;

\ The call-path panel: enclosing words (lcstk, outermost first) then the current one.
variable lci
: draw-call ( -- )
  lcur @ 0= if  exit  then                     \ not inside a word yet
  0 lci !
  begin  lci @ lcn @ <  while
    lcstk lci @ cells + @  .cfaname  space [char] > emit space
    lci @ 1+ lci !
  repeat
  1 sgr  lcur @ .cfaname  reset ;

\ The code panel: the current word's body (lcur), highlighting the cell at the live IP
\ (%rsi-8 — lodsq has advanced past the cell just dispatched). Decoded straight from the
\ shared dictionary with `@`, skipping inline LIT/branch operands like `see`.
variable ldp
: ltok ( -- )
  ldp @  r-rsi 8 -  = if  1 sgr 3 fg  then      \ highlight the live current cell
  ldp @ @
  dup 'exit    = if  drop [char] ; emit                                      ldp @ 8 +  ldp !
  else dup 'lit    = if  drop [char] # emit  ldp @ 8 + @ .n                  ldp @ 16 + ldp !
  else dup 'branch = if  drop [char] b emit space ldp @ 8 + @ .n            ldp @ 16 + ldp !
  else dup '0branch = if  drop [char] 0 emit [char] b emit space ldp @ 8 + @ .n  ldp @ 16 + ldp !
  else  .cfaname                                                            ldp @ 8 +  ldp !
  then then then then
  reset space ;
: draw-code ( -- )
  lcur @ 0= if  exit  then
  lcur @ cell+ ldp !
  begin  ldp @ @ 'exit =  >r  ltok  r>  until ;

\ --- non-interactive core (testable in a pipe): print the live stack each step ---
\ Proof that we're reading the *real* engine: tracing `5 square` shows the data stack
\ evolve 5 -> 5 5 -> 25, peeked from the child at each dispatch.
: live-trace ( n cfa -- )
  fork dup 0= if
    drop  traceme  getpid SIGSTOP kill  execute  bye
  else
    child !  2drop
    -1 alive !  0 lsteps !
    pwait drop
    begin  l-step  alive @  while
      r-rax .dispatched  [char] : emit space  .lstack  cr
    repeat
  then ;

\ --- the interactive TUI (the same call/code/data view as ember.fr, live) --------
variable lquit
: .live  ( -- ) [char] l emit [char] i emit [char] v emit [char] e emit ;
: .real  ( -- ) [char] r emit [char] e emit [char] a emit [char] l emit space
                [char] e emit [char] n emit [char] g emit [char] i emit [char] n emit [char] e emit ;
: .call  ( -- ) [char] c emit [char] a emit [char] l emit [char] l emit ;
: .code  ( -- ) [char] c emit [char] o emit [char] d emit [char] e emit ;
: .data  ( -- ) [char] d emit [char] a emit [char] t emit [char] a emit ;
: .ended ( -- ) [char] e emit [char] x emit [char] i emit [char] t emit
                [char] e emit [char] d emit ;
: .keys  ( -- ) [char] s emit [char] p emit [char] a emit [char] c emit [char] e emit
                [char] = emit [char] s emit [char] t emit [char] e emit [char] p emit space space
                [char] q emit [char] = emit [char] q emit [char] u emit [char] i emit [char] t emit ;
: draw-live ( -- )
  clear
  1 2 at  6 fg bold  .live  reset  space space [char] # emit  lsteps @ .n
          space space  2 sgr .real reset
  3 2 at  2 sgr .call reset  3 9 at  draw-call
  5 2 at  2 sgr .code reset  5 9 at  alive @ if  draw-code  then
  7 2 at  2 sgr .data reset  7 9 at  alive @ if  .lstack  else  2 sgr .ended reset  then
  9 2 at  .keys ;
: live ( n cfa -- )                  \ usage:  <args> ' <word> live
  fork dup 0= if
    drop  traceme  getpid SIGSTOP kill  execute  bye
  else
    child !  2drop
    -1 alive !  0 lsteps !  0 lcur !  0 lcn !  0 lquit !
    pwait drop
    alive @ if  l-step  then          \ advance to the first dispatch boundary
    raw-on  hide-cursor
    begin
      draw-live
      key                                                    ( c )
      dup [char] q = if  drop  -1 lquit !
      else dup 27 =  if  drop  -1 lquit !
      else dup 0<    if  drop  -1 lquit !
      else dup [char] s = over 32 = or if  drop  alive @ if  l-step  then
      else drop
      then then then then
      lquit @
    until
    alive @ if  child @ SIGKILL kill  pwait drop  then       \ reap the child if still alive
    show-cursor  reset  raw-off  cr  bye
  then ;
