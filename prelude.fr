\ prelude.fr — fr's standard library: every word derivable from the kernel
\ primitives, written in fr itself. Keeping these out of fr.s keeps the assembly
\ kernel minimal and auditable. Load the prelude for the full vocabulary:
\
\     ( cat prelude.fr yourprog.fr ) | ./fr
\
\ Rule: if a word can be defined in fr, it belongs here, not in fr.s. The kernel
\ now keeps only the irreducible primitives (the engine, dup/drop/swap, the
\ return-stack and memory words, +/-/*//mod, =/<, and/or, the I/O and compiling
\ words). Everything below is built from those.  (anvil.fr depends on this.)

\ --- stack (over/rot built from the return stack) ----------------------------
: over  ( a b -- a b a )    >r dup r> swap ;
: rot   ( a b c -- b c a )  >r swap r> swap ;
: nip   ( a b -- b )        swap drop ;
: 2dup  ( a b -- a b a b )  over over ;
: 2drop ( a b -- )          drop drop ;

\ --- arithmetic --------------------------------------------------------------
: negate ( n -- -n )   0 swap - ;
: 1+     ( n -- n+1 )  1 + ;
: 1-     ( n -- n-1 )  1 - ;
: cells  ( n -- n*8 )  8 * ;
: cell+  ( a -- a+8 )  8 + ;

\ --- comparison --------------------------------------------------------------
: >      ( a b -- f )  swap < ;
: 0=     ( n -- f )    0 = ;

\ --- dictionary / parsing ----------------------------------------------------
: ,      ( x -- )   here !  8 allot ;       \ append a cell at HERE
: char   ( -- c )   word drop c@ ;          \ code of the next token's first char

\ --- output ------------------------------------------------------------------
: cr     ( -- )   10 emit ;
: space  ( -- )   32 emit ;

\ u. — print an unsigned number with no trailing newline, by extracting decimal
\ digits with /mod into a buffer and typing them. The kernel's `.` always adds a
\ newline; u. is the building block for inline / formatted numeric output.
variable ubuf  32 allot
variable up
: u. ( u -- )
  ubuf 32 + up !                 \ build digits from the end of the buffer
  begin
    dup 10 mod  [char] 0 +       ( u digit-char )
    up @ 1-  dup up !  c!         ( store digit, predecrement up )
    10 /
    dup 0=
  until
  drop
  up @   ubuf 32 + over -   type ;
: .n ( n -- )   dup 0 < if  [char] - emit  negate  then  u. ;   \ signed, no newline
: '  ( -- cfa )   word find ;                                    \ tick: next word's CFA

\ --- handy demo word ---------------------------------------------------------
: square ( n -- n*n )  dup * ;

\ --- see: a self-hosted thread decoder (fr disassembling itself) -------------
\ Names for the headerless engine words, from the kernel's `sys` table:
sys      @  constant 'docol
sys 8 +  @  constant 'lit
sys 16 + @  constant 'exit
sys 24 + @  constant 'branch
sys 32 + @  constant '0branch

variable target  variable found  variable hp
: .cfaname ( cfa -- )           \ print the name of the word whose CFA this is
  target !  latest hp !  0 found !
  begin  hp @ 0=  found @  or  0=  while       \ while hp != 0 and not yet found
    hp @ 8 + c@ 127 and  hp @ 9 + +  target @ =  \ this header's CFA == target?
    if    hp @ 9 +   hp @ 8 + c@ 127 and   type   -1 found !
    else  hp @ @ hp !  then                     \ else follow the link
  repeat
  found @ 0= if [char] ? emit then ;

variable sp  variable done
: see ( -- )                    \ see <word> — print its threaded definition
  word find  dup 0= if  drop [char] ? emit cr  exit  then     ( cfa )
  dup @ 'docol =  0= if          \ codeword isn't docol -> it's a primitive
    drop  [char] p emit [char] r emit [char] i emit [char] m emit cr  exit
  then
  8 + sp !  0 done !             \ body begins one cell after the CFA
  begin
    sp @ @                       ( cell )
    dup 'exit    = if  drop  [char] ; emit                       -1 done !
    else dup 'lit    = if  drop  sp @ 8 + @ .n space   sp @ 16 + sp !
    else dup 'branch = if  drop  [char] b emit space sp @ 8 + @ .n space sp @ 16 + sp !
    else dup '0branch = if drop [char] 0 emit [char] b emit space sp @ 8 + @ .n space sp @ 16 + sp !
    else  .cfaname space  sp @ 8 + sp !
    then then then then
    done @
  until
  cr ;
