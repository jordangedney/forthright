#!/usr/bin/env python3
"""ember-fr — launch the self-hosted fr ember (ember.fr) under a pty.

fr's `raw-on` does an ioctl on fd 0, so it needs a *real* terminal; a plain pipe
won't do. This hands fr a pty, preloads prelude.fr + term.fr + ember.fr, runs a
stepping command, and bridges your terminal to it. (This launcher is host-glue —
the TUI itself is entirely in ember.fr; see DECISIONS.md.)

    ./ember-fr ["<cmd>"]     interactive; default cmd:  5 ' square ember
    ./ember-fr --selftest    headless: script keystrokes, assert the stack steps
"""
import os, sys, pty, select, struct, termios, tty, fcntl, time

HERE = os.path.dirname(os.path.abspath(__file__))
LIB  = ("prelude.fr", "term.fr", "ember.fr")
LIVE = ("prelude.fr", "term.fr", "ptrace.fr", "live.fr")


def spawn(cmd, rows=24, cols=80, files=LIB):
    """Fork ./fr onto a pty and feed it the stepping command.

    fr loads the library itself from its file arguments (`./fr prelude.fr term.fr
    ember.fr`), so all this launcher does is provide a real tty (for `raw-on`) and
    type the command. The same thing works with no Python at all, in a terminal:
        ./fr prelude.fr term.fr ember.fr      (then type: 5 ' square ember)"""
    pid, fd = pty.fork()
    if pid == 0:                                   # child becomes fr, loading the .fr files
        os.chdir(HERE)
        os.execv("./fr", ["./fr", *files])
        os._exit(127)
    try:                                           # make term-size meaningful
        fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack("HHHH", rows, cols, 0, 0))
    except OSError:
        pass
    try:                                           # raw: keystrokes pass straight through
        a = termios.tcgetattr(fd)
        a[3] &= ~(termios.ICANON | termios.ECHO)
        termios.tcsetattr(fd, termios.TCSANOW, a)
    except termios.error:
        pass
    os.write(fd, (cmd + "\n").encode())            # fr reads this from stdin after the files
    return pid, fd


def drain(fd, timeout=0.4):
    out = b""
    while True:
        r, _, _ = select.select([fd], [], [], timeout)
        if not r:
            break
        try:
            chunk = os.read(fd, 65536)
        except OSError:
            break
        if not chunk:
            break
        out += chunk
    return out


def read_until(fd, needle, timeout=3.0):
    """Read until `needle` appears (event-driven, fast) or `timeout` elapses."""
    out = b""
    deadline = time.time() + timeout
    while time.time() < deadline:
        r, _, _ = select.select([fd], [], [], deadline - time.time())
        if not r:
            break
        try:
            chunk = os.read(fd, 65536)
        except OSError:
            break
        if not chunk:
            break
        out += chunk
        if needle in out:
            break
    return out


def selftest():
    """Step `5 square` cell by cell, asserting the stack evolves 5 -> 5 5 -> 25.

    Every frame ends with the status line (`...q=quit`), so we wait for that
    sentinel after each keypress instead of sleeping a fixed interval."""
    pid, fd = spawn("5 ' square ember")
    frames = read_until(fd, b"q=quit")              # boot + first frame
    for key in (b"s", b"s", b"s"):                  # step dup, *, then EXIT (done)
        os.write(fd, key)
        frames += read_until(fd, b"q=quit")         # the redrawn frame
    os.write(fd, b"q")                              # quit -> fr exits
    frames += drain(fd, 0.3)                        # let it exit cleanly
    try:
        os.close(fd)
        os.waitpid(pid, 0)
    except OSError:
        pass
    checks = [("dup", b"dup" in frames),            # thread decoded
              ("25",  b"25"  in frames),            # square 5 -> 25 on the stack
              ("done", b"done" in frames)]          # reached EXIT, stepper halted
    ok = all(c[1] for c in checks)
    if ok:
        print("EMBER-FR PASS")
        return 0
    print("EMBER-FR FAIL (missing: " +
          " ".join(name for name, hit in checks if not hit) + ")")
    return 1


def live_selftest():
    """Drive the LIVE backend (live.fr) under a pty: step `5 square` on the real engine,
    asserting the peeked data stack reaches 25 and the child eventually exits."""
    pid, fd = spawn("5 ' square live", files=LIVE)
    frames = read_until(fd, b"q=quit")              # advanced to the first dispatch
    for _ in range(12):                             # step through square + bye
        os.write(fd, b"s")
        frames += read_until(fd, b"q=quit", timeout=2.0)
        if b"exited" in frames:
            break
    os.write(fd, b"q")
    frames += drain(fd, 0.3)
    try:
        os.close(fd)
        os.waitpid(pid, 0)
    except OSError:
        pass
    checks = [("dup", b"dup" in frames),            # trail shows the real dispatch
              ("25",  b"25"  in frames),            # live data stack reached 25
              ("exited", b"exited" in frames)]      # the traced child ran to completion
    ok = all(c[1] for c in checks)
    if ok:
        print("EMBER-FR LIVE PASS")
        return 0
    print("EMBER-FR LIVE FAIL (missing: " +
          " ".join(name for name, hit in checks if not hit) + ")")
    return 1


def interactive(cmd, files=LIB):
    rows, cols = 24, 80
    try:
        ws = fcntl.ioctl(sys.stdout.fileno(), termios.TIOCGWINSZ, b"\0" * 8)
        rows, cols, _, _ = struct.unpack("HHHH", ws)
    except OSError:
        pass
    pid, fd = spawn(cmd, rows, cols, files=files)
    stdin = sys.stdin.fileno()
    old = termios.tcgetattr(stdin)
    try:
        tty.setraw(stdin)                           # our keys pass straight to fr
        while True:
            r, _, _ = select.select([stdin, fd], [], [])
            if fd in r:
                try:
                    data = os.read(fd, 65536)
                except OSError:
                    break
                if not data:
                    break
                os.write(sys.stdout.fileno(), data)
            if stdin in r:
                data = os.read(stdin, 65536)
                if not data:
                    break
                os.write(fd, data)
    finally:
        termios.tcsetattr(stdin, termios.TCSADRAIN, old)
        try:
            os.close(fd)
        except OSError:
            pass


def main():
    args = sys.argv[1:]
    if args and args[0] == "--selftest":
        sys.exit(selftest())
    if args and args[0] == "--live-selftest":
        sys.exit(live_selftest())
    if args and args[0] == "--live":               # ./ember-fr --live ["3 ' cube live"]
        interactive(args[1] if len(args) > 1 else "5 ' square live", files=LIVE)
        return
    interactive(args[0] if args else "5 ' square ember")


if __name__ == "__main__":
    main()
