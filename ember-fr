#!/usr/bin/env bash
# ember-fr — launch the self-hosted explorer (no Python). Give it a stepping command,
# or get the default `5 ' square ember`. Then drive it with the keys shown in the TUI:
#
#     space / s   step one cell        r   run to the end
#     e           edit (type a new     q   quit
#                 target, e.g. 3 square)
#
#   ./ember-fr                                          # step `square` on 5 (default)
#   ./ember-fr "3 ' square ember"                       # step `square` on 3
#   ./ember-fr ": cube dup square * ;  3 ' cube ember"  # define a word, then step it
#
# How it works: it runs the real explorer —  ./fr ember.fr <your command>
# (ember.fr `include`s its own deps: lib/prelude.fr lib/term.fr lib/ptrace.fr).
# Your command is passed as a *file* argument (process substitution), so it runs at
# startup while your keystrokes still come from the terminal (the tty `raw-on` needs).
# For totally hands-on use you can run `./fr ember.fr` yourself and type the command.
cd "$(dirname "$0")" || exit 1
cmd="$*"
[ -z "$cmd" ] && cmd="ember"
exec ./fr ember.fr <(printf '%s\n' "$cmd")
