#!/bin/sh
# ember-fr — launch the self-hosted explorer. No Python needed: fr loads the library
# from its file arguments, and the terminal itself is the real tty that `raw-on` wants.
# Then type a stepping command at the (prompt-less) REPL, e.g.:
#
#     5 ' square ember
#     : cube dup square * ;   3 ' cube ember
#
# Keys in the TUI: space/s step · r run · e edit (type a new target) · q quit.
# (Scripted/headless testing needs to pace keystrokes through a pty — see ember-pty.)
cd "$(dirname "$0")" || exit 1
exec ./fr prelude.fr term.fr ptrace.fr ember.fr
