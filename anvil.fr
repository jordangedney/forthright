\ anvil.fr — a stack-effect verifier, written in fr (self-hosted).
\
\ The project thesis made literal: the error-correcting redundancy Forth lacks,
\ supplied OUTSIDE the shipped artifact — and small enough to audit, because it
\ is itself a few dozen lines of the same minimal Forth.
\
\ Two ways to use it (load anvil.fr first, then feed phrases):
\   check{ dup dup * * }              \ infer a straight-line phrase's effect
\   def sq ( n -- n ) dup * ;          \ define+check a word vs its declaration
\ Effects print as  ( x -- y )  (one x per input cell, one y per output cell).
\
\ How: a name -> (consumes, produces) table. `def`/`prim` register effects;
\ check{ / def run the abstract stack simulation from anvil-reference.py — track
\ the running height and the lowest dip; inputs = -low, outputs = inputs+height.
\ Words anvil already knows compose, so `def` builds a vocabulary. Sound for
\ straight-line code (all fr is, for now).

\ --- storage: an effect table + a names blob (both bump-allocated) -----------
variable tp   variable tbase      \ table: entries of [name-ptr, name-len, cons, prod]
variable np   variable nbase      \ names blob (copied token text)
variable csp  variable csbase     \ control-flow stack (for nested if/else/then)
variable imb                      \ count of branch imbalances found
here dup tbase ! tp !   8000 allot
here dup nbase ! np !   8000 allot
here dup csbase ! csp !  400 allot

\ --- simulation + scratch state ----------------------------------------------
variable hgt   variable lo   variable unk   variable pp
variable fcons variable fprod variable ffound
variable q-a   variable q-n           \ tlookup query
variable tok-a variable tok-n         \ current token
variable cn-a  variable cn-n          \ copy-name source
variable dc                           \ emits char
variable ein   variable eout          \ .eff counts
variable din   variable dout variable has-decl
variable cons-i variable prod-i       \ inferred effect of a def
variable rg-c  variable rg-p  variable rg-len   \ register cons/prod/name-len
variable name-a variable name-n       \ a def's name
variable kcfa  variable bp2           \ check-body: cfa key, body pointer

: t.str ( -- addr len )  tok-a @ tok-n @ ;   \ (space, cr, 1+, 2dup… come from prelude.fr)

\ --- output: render an effect as ( x.. -- y.. ) ------------------------------
: emits ( n c -- )  dc !  begin dup 0 > while  dc @ emit  1-  repeat  drop ;
: .eff ( in out -- )
  eout !  ein !
  [char] ( emit space
  ein @ [char] x emits
  space [char] - emit [char] - emit space
  eout @ [char] y emits
  space [char] ) emit cr ;

\ --- building the table ------------------------------------------------------
: ,e ( x -- )  tp @ !  tp @ 8 + tp ! ;          \ append a cell, bump tp
: cs-push ( x -- )  csp @ !  csp @ 8 + csp ! ;   \ push onto the control stack
: cs-pop  ( -- x )  csp @ 8 - csp !  csp @ @ ;   \ pop from the control stack
: copy-name ( addr len -- ptr )                  \ copy token into the names blob
  cn-n !  cn-a !
  np @                                           \ result = current np
  begin  cn-n @ 0 >  while
    cn-a @ c@  np @ c!
    cn-a @ 1+ cn-a !   np @ 1+ np !   cn-n @ 1- cn-n !
  repeat ;
: register ( cfa addr len cons prod -- )         \ entry: [cfa, name-ptr, len, cons, prod]
  rg-p !  rg-c !  rg-len !                        \ ( cfa addr )
  rg-len @ copy-name                              \ ( cfa ptr )
  swap ,e  ,e                                     \ cfa, name-ptr
  rg-len @ ,e   rg-c @ ,e   rg-p @ ,e ;            \ len, cons, prod
: prim ( cons prod -- )                          \ name follows; record its CFA too
  rg-p ! rg-c !
  word 2dup find                                  \ ( addr len cfa )
  rot rot                                         \ ( cfa addr len )
  rg-c @ rg-p @  register ;

\ --- the stack-effect simulation ---------------------------------------------
: apply ( cons prod -- )
  pp !
  hgt @ swap -  hgt !                            \ hgt -= cons
  hgt @ lo @ <  if  hgt @ lo !  then             \ track low-water mark
  hgt @ pp @ +  hgt ! ;                          \ hgt += prod

: tlookup ( addr len -- cons prod flag )         \ look up a name's effect
  q-n !  q-a !  0 ffound !
  tbase @
  begin  dup tp @ <  while
    dup 8 + @  over 16 + @  q-a @ q-n @  s=  if    \ entry: name-ptr@+8, len@+16
      dup 24 + @ fcons !
      dup 32 + @ fprod !
      -1 ffound !
    then
    40 +
  repeat  drop
  ffound @  if  fcons @ fprod @ -1  else  0 0 0  then ;

: tlookup-cfa ( cfa -- cons prod flag )          \ look up by compiled CFA (entry@+0)
  kcfa !  0 ffound !
  tbase @
  begin  dup tp @ <  while
    dup @  kcfa @ =  if
      dup 24 + @ fcons !
      dup 32 + @ fprod !
      -1 ffound !
    then
    40 +
  repeat  drop
  ffound @  if  fcons @ fprod @ -1  else  0 0 0  then ;

: check-body ( body -- in out )                  \ simulate a compiled straight-line body
  bp2 !  0 hgt !  0 lo !
  begin  bp2 @ @  dup 'exit =  0=  while           \ until the EXIT cell
    tlookup-cfa  if  apply  else  2drop  then
    bp2 @ 8 + bp2 !
  repeat  drop
  lo @ negate   lo @ negate hgt @ +  ;             \ ( inputs outputs )

\ --- token predicates (operate on the current tok-a/tok-n) -------------------
: read-tok ( -- )  word tok-n ! tok-a ! ;
: 1char? ( c -- flag )  tok-n @ 1 =  swap  tok-a @ c@ =  and ;
: end?  ( -- flag )  [char] } 1char? ;
: semi? ( -- flag )  [char] ; 1char? ;
: lp?   ( -- flag )  [char] ( 1char? ;
: rp?   ( -- flag )  [char] ) 1char? ;
: dd?   ( -- flag )  tok-n @ 2 =  tok-a @ c@ [char] - =  and
                     tok-a @ 1+ c@ [char] - =  and ;
: if?   ( -- flag )  tok-n @ 2 =  tok-a @ c@ [char] i =  and
                     tok-a @ 1+ c@ [char] f =  and ;
: else? ( -- flag )  tok-n @ 4 =  tok-a @ c@      [char] e =  and
                     tok-a @ 1+ c@ [char] l =  and  tok-a @ 2 + c@ [char] s =  and
                     tok-a @ 3 + c@ [char] e =  and ;
: then? ( -- flag )  tok-n @ 4 =  tok-a @ c@      [char] t =  and
                     tok-a @ 1+ c@ [char] h =  and  tok-a @ 2 + c@ [char] e =  and
                     tok-a @ 3 + c@ [char] n =  and ;

\ --- branch handling: an if/else/then must leave both arms at the same height -
: bad-branch ( -- )  imb @ 1+ imb ! ;
: do-if ( -- )      \ consume the flag, then remember the arm-start height
  1 0 apply  hgt @ cs-push  0 cs-push ;          \ push h0, kind=0 (no else yet)
: do-else ( -- )    \ stash the true-arm result, reset to h0 for the else-arm
  cs-pop drop  cs-pop                            \ ( h0 )  (drop kind=0)
  hgt @ swap  hgt !                              \ hT on stack ; hgt := h0
  cs-push  1 cs-push ;                           \ push hT, kind=1 (else seen)
: do-then ( -- )    \ require the two arms to agree
  cs-pop  if                                     \ kind=1: had an else
    cs-pop  hgt @ =  0=  if  bad-branch  then     \ hT must equal else-arm height
  else                                           \ kind=0: empty else arm at h0
    cs-pop  dup hgt @ =  0=  if  bad-branch  then  \ true-arm must be height-neutral
    hgt !
  then ;

\ --- classify one token into the running simulation --------------------------
: classify ( -- )
  if?   if  do-if    exit  then                   \ control flow first
  else? if  do-else  exit  then
  then? if  do-then  exit  then
  t.str number  swap drop                        \ a number?
  if  0 1 apply  exit  then                       \ literal: ( -- n )
  t.str tlookup                                   \ a known word?
  if  apply  else  2drop  unk @ 1+ unk !  then ;   \ else unknown

\ --- reports -----------------------------------------------------------------
: .imb ( -- )  imb @  if  [char] b emit [char] r emit [char] ! emit cr  then ;
: report ( -- )                                  \ for check{
  lo @ negate   lo @ negate hgt @ +   .eff
  unk @  if  [char] ? emit space unk @ .  then
  .imb ;

: okmsg  ( -- )  [char] o emit [char] k emit cr ;
: badmsg ( -- )  [char] B emit [char] A emit [char] D emit space din @ dout @ .eff ;
: report-def ( -- )
  name-a @ name-n @ type space
  cons-i @ prod-i @ .eff
  has-decl @  if
    cons-i @ din @ =  prod-i @ dout @ =  and
    if  okmsg  else  badmsg  then
  then
  .imb ;

\ --- the two entry points ----------------------------------------------------
: check{ ( -- )           \ check{ <words> }
  0 hgt !  0 lo !  0 unk !  csbase @ csp !  0 imb !
  begin  read-tok  end? 0=  while  classify  repeat
  report ;

: parse-decl ( -- )       \ called just after reading '(' ; counts in/out
  -1 has-decl !  0 din !  0 dout !
  begin  read-tok  dd? 0=  while  din  @ 1+ din  !  repeat
  begin  read-tok  rp? 0=  while  dout @ 1+ dout !  repeat ;

: def ( -- )              \ def name [ ( in -- out ) ] body ;
  read-tok  tok-a @ name-a !  tok-n @ name-n !
  0 hgt !  0 lo !  0 unk !  0 has-decl !  csbase @ csp !  0 imb !
  read-tok  lp? if  parse-decl  read-tok  then
  begin  semi? 0=  while  classify  read-tok  repeat
  lo @ negate cons-i !  cons-i @ hgt @ + prod-i !
  0 name-a @ name-n @ cons-i @ prod-i @ register   \ cfa=0 (user word, not compiled)
  report-def ;

\ --- the primitive effect table ( consumes produces prim <name> ) ------------
1 2 prim dup      1 0 prim drop     2 2 prim swap     2 3 prim over
3 3 prim rot      2 1 prim +        2 1 prim -        2 1 prim *
1 1 prim negate   1 1 prim 1+       1 1 prim 1-       2 1 prim and
2 1 prim or       2 1 prim =        2 1 prim <        2 1 prim >
1 1 prim 0=       1 0 prim .        1 1 prim square
2 1 prim /        2 1 prim mod
