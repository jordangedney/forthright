include lib/prelude.fr			\ depends on: prelude, math (<= >= used below)
include lib/math.fr

\ anvil.fr — a stack-effect verifier, written in fr (self-hosted).
\
\ The project thesis made literal: the error-correcting redundancy Forth lacks,
\ supplied OUTSIDE the shipped artifact — and small enough to audit, because it
\ is itself a few dozen lines of the same minimal Forth.
\
\ Two ways to use it (load anvil.fr first, then feed phrases):
\   check{ dup dup * * }              \ infer a straight-line phrase's effect
\   def sq ( n -- n ) dup * ;          \ define+check a word vs its declaration
\ Effects print as  ( x -- y )  (one x per input cell, one y per output cell).
\
\ What it statically checks (by abstract stack simulation — see anvil-spec.md):
\   - infers each word's ( in -- out ) and checks it against the declaration;
\   - flags unknown words, by name              ->  ? foo bar
\   - if/else/then: both arms must agree         ->  br!
\   - begin/until, begin/while/repeat, do/loop:  loop body must be stack-neutral  ->  br!
\   - control structures must be balanced (every if a then, &c.)  ->  ctl!
\   - return stack must balance (>r / r> / r@)   ->  r!
\   - cell KINDS (number / address / flag): @ ! c@ c! need an address, * / mod don't
\     take an address, + rejects address+address                 ->  ty!
\   - recursion: a *declared* word may call itself (the self-call assumes the decl).
\ Kinds flow from literals (number), comparisons (flag), and a declaration whose input
\ names say so (`addr`/`ptr` -> address, `n`/`u` -> number, `flag` -> flag); an unknown
\ kind never triggers ty!, so false positives are avoided.
\ Sound for the straight-line + structured code fr produces. It proves SHAPE (and a little
\ kind), never VALUE (`dup +` checks as ( n -- n ) but doesn't square) — intent is forge's job.

\ --- storage: an effect table + a names blob (both bump-allocated) -----------
variable tp   variable tbase      \ table: entries of [cfa, name-ptr, name-len, cons, prod]
variable np   variable nbase      \ names blob (copied token text)
variable csp  variable csbase     \ control-flow stack (nested if/else/then, loops)
variable unkp variable unkbase    \ unknown-token list: pairs of [name-ptr, name-len]
variable imb                      \ count of branch / loop arm imbalances
variable cerr                     \ count of control-structure imbalances (missing then/until/…)
variable rerr                     \ -1 if the return stack didn't balance
variable rdep                     \ running return-stack depth (>r +1, r> -1)
variable terr                     \ count of cell-kind (type) errors
variable zerr                     \ count of division-by-literal-zero
variable exiterr                  \ -1 if early `exit` effects disagree with the fall-through
variable nexits  variable exit-in variable exit-out   \ early-return bookkeeping (first exit's effect)
variable post-exit                \ -1 right after an `exit`, until a then/else/loop-closer
variable deaderr                  \ -1 if code was found between an `exit` and its closer
variable astk  320 cells allot    \ abstract cell KINDS, indexed by height (see ABASE below)
here dup tbase ! tp !   8000 allot
here dup nbase ! np !   8000 allot
here dup csbase ! csp !  400 allot
here dup unkbase ! unkp ! 400 allot

\ --- simulation + scratch state ----------------------------------------------
variable hgt   variable lo   variable unk   variable pp
variable fcons variable fprod variable fokind variable ffound   \ tlookup results (incl. out-kind)
variable ro    variable dok  variable iok    \ register out-kind; declared & inferred output kind
variable q-a   variable q-n           \ tlookup query
variable tok-a variable tok-n         \ current token
variable cn-a  variable cn-n          \ copy-name source
variable dc                           \ emits char
variable ein   variable eout          \ .eff counts
variable din   variable dout variable has-decl
variable cons-i variable prod-i       \ inferred effect of a def
variable rg-c  variable rg-p  variable rg-len   \ register cons/prod/name-len
variable name-a variable name-n       \ a def's name
variable kcfa  variable bp2           \ check-body: cfa key, body pointer
variable def-entry                    \ table entry of the word being def'd (for recursion)
variable ui                           \ .unknowns iterator

: t.str ( -- addr len )  tok-a @ tok-n @ ;   \ (space, cr, 1+, 2dup… come from prelude.fr)

\ control-structure kinds (tag on each control-stack frame)
1 constant K-IF   2 constant K-ELSE   3 constant K-BEGIN   4 constant K-WHILE   5 constant K-DO

\ --- output: render an effect as ( x.. -- y.. ) ------------------------------
: emits ( n c -- )  dc !  begin dup 0 > while  dc @ emit  1-  repeat  drop ;
: .eff ( in out -- )
  eout !  ein !
  [char] ( emit space
  ein @ [char] x emits
  space [char] - emit [char] - emit space
  eout @ [char] y emits
  space [char] ) emit cr ;

\ --- building the table ------------------------------------------------------
: ,e ( x -- )  tp @ !  tp @ 8 + tp ! ;          \ append a cell, bump tp
: cs-push ( x -- )  csp @ !  csp @ 8 + csp ! ;   \ push onto the control stack
: cs-pop  ( -- x )  csp @ 8 - csp !  csp @ @ ;   \ pop from the control stack
: cs-empty? ( -- f )  csp @ csbase @ <= ;
: copy-name ( addr len -- ptr )                  \ copy token into the names blob
  cn-n !  cn-a !
  np @                                           \ result = current np
  begin  cn-n @ 0 >  while
    cn-a @ c@  np @ c!
    cn-a @ 1+ cn-a !   np @ 1+ np !   cn-n @ 1- cn-n !
  repeat ;
: register ( cfa addr len cons prod okind -- )    \ entry: [cfa, name-ptr, len, cons, prod, okind]
  ro !  rg-p !  rg-c !  rg-len !                   \ ( cfa addr )
  rg-len @ copy-name                              \ ( cfa ptr )
  swap ,e  ,e                                     \ cfa, name-ptr
  rg-len @ ,e   rg-c @ ,e   rg-p @ ,e   ro @ ,e ;  \ len, cons, prod, out-kind
: prim ( cons prod -- )                          \ name follows; record its CFA, out-kind unknown
  rg-p ! rg-c !
  word 2dup find                                  \ ( addr len cfa )
  rot rot                                         \ ( cfa addr len )
  rg-c @ rg-p @  0  register ;                     \ 0 = K? (unknown out-kind; K? is defined later)

\ --- cell-kind layer: a kind for every abstract cell, indexed by height ------
\ astk[ABASE + h] is the kind of the cell at height h (h<0 = a consumed input). The
\ height sim (hgt/lo) is untouched; this rides alongside it. Out-of-range is treated as
\ unknown / no-op so a deep stack can never corrupt memory.
0 constant K?   1 constant KN   2 constant KA   3 constant KF   4 constant KZ
\ unknown / number / address / flag / literal-zero (a number we know is 0, for div-by-zero)
64 constant ABASE
variable sk0  variable sk1  variable sk2          \ saved consumed kinds (top, 2nd, 3rd)
: inb ( idx -- idx f )  dup 0 >=  over 320 <  and ;
: k@h ( h -- kind )  ABASE + inb if  cells astk + @   else  drop K?  then ;
: k!h ( kind h -- )  ABASE + inb if  cells astk + !   else  2drop   then ;
: topk ( -- kind )  hgt @ 1- k@h ;
: 2ndk ( -- kind )  hgt @ 2 - k@h ;
: kset ( kind -- )  hgt @ 1- k!h ;                \ set the (post-apply) top cell's kind
: a-clear ( -- )  astk 320 cells 0 fill ;         \ all cells -> K? (0)

\ --- the stack-effect simulation ---------------------------------------------
: apply ( cons prod -- )
  pp !
  hgt @ swap -  hgt !                            \ hgt -= cons
  hgt @ lo @ <  if  hgt @ lo !  then             \ track low-water mark
  hgt @ pp @ +  hgt !                            \ hgt += prod
  pp @ begin dup 0 > while                       \ produced cells (heights hgt-1..hgt-prod) default K?
    dup hgt @ swap -  K? swap k!h  1- repeat drop ;

: tlookup ( addr len -- cons prod okind flag )   \ look up a name's effect (entries are 48 bytes)
  q-n !  q-a !  0 ffound !
  tbase @
  begin  dup tp @ <  while
    dup 8 + @  over 16 + @  q-a @ q-n @  s=  if    \ entry: name-ptr@+8, len@+16
      dup 24 + @ fcons !
      dup 32 + @ fprod !
      dup 40 + @ fokind !
      -1 ffound !
    then
    48 +
  repeat  drop
  ffound @  if  fcons @ fprod @ fokind @ -1  else  0 0 0 0  then ;

: tlookup-cfa ( cfa -- cons prod flag )          \ look up by compiled CFA (entry@+0)
  kcfa !  0 ffound !
  tbase @
  begin  dup tp @ <  while
    dup @  kcfa @ =  if
      dup 24 + @ fcons !
      dup 32 + @ fprod !
      -1 ffound !
    then
    48 +
  repeat  drop
  ffound @  if  fcons @ fprod @ -1  else  0 0 0  then ;

: check-body ( body -- in out )                  \ simulate a compiled straight-line body
  bp2 !  0 hgt !  0 lo !
  begin  bp2 @ @  dup 'exit =  0=  while           \ until the EXIT cell
    tlookup-cfa  if  apply  else  2drop  then
    bp2 @ 8 + bp2 !
  repeat  drop
  lo @ negate   lo @ negate hgt @ +  ;             \ ( inputs outputs )

\ --- token predicates (operate on the current tok-a/tok-n) -------------------
: read-tok ( -- )  word tok-n ! tok-a ! ;
: tok=  ( addr len -- flag )  t.str s= ;          \ does the current token equal this string?
: end?    ( -- f )  s" }"      tok= ;
: semi?   ( -- f )  s" ;"      tok= ;
: lp?     ( -- f )  s" ("      tok= ;
: rp?     ( -- f )  s" )"      tok= ;
: dd?     ( -- f )  s" --"     tok= ;
: if?     ( -- f )  s" if"     tok= ;
: else?   ( -- f )  s" else"   tok= ;
: then?   ( -- f )  s" then"   tok= ;
: begin?  ( -- f )  s" begin"  tok= ;
: until?  ( -- f )  s" until"  tok= ;
: while?  ( -- f )  s" while"  tok= ;
: repeat? ( -- f )  s" repeat" tok= ;
: do?     ( -- f )  s" do"     tok= ;
: loop?   ( -- f )  s" loop"   tok= ;
\ string parsing words (can't write a `"` inside s", so match the 2 chars directly):
: sq?    ( -- f )  tok-n @ 2 =  tok-a @ c@ [char] s =  and  tok-a @ 1+ c@ [char] " =  and ;
: dotq?  ( -- f )  tok-n @ 2 =  tok-a @ c@ [char] . =  and  tok-a @ 1+ c@ [char] " =  and ;
: ends-quote? ( -- f )  tok-n @ 0= if  0  else  tok-a @ tok-n @ + 1- c@ [char] " =  then ;
: skip-string ( -- )  begin  read-tok  ends-quote?  tok-n @ 0= or  until ;  \ consume to the closing "

\ --- unknown-word recording (by name, so reports can show them) --------------
: unk, ( x -- )  unkp @ !  unkp @ 8 + unkp ! ;
: unk! ( addr len -- )                           \ record an unknown token + bump the count
  unk @ 1+ unk !
  dup >r  copy-name  unk,  r> unk, ;             \ store [name-ptr, len]

\ --- branch handling: an if/else/then must leave both arms at the same height -
: bad-branch ( -- )  imb @ 1+ imb ! ;
: c-bad      ( -- )  cerr @ 1+ cerr ! ;
: do-if ( -- )      \ consume the flag, remember the arm-start height
  1 0 apply  hgt @ cs-push  K-IF cs-push ;
: do-else ( -- )    \ stash the true-arm result, reset to h0 for the else-arm
  cs-empty? if  c-bad exit then
  cs-pop K-IF = 0= if  c-bad exit then
  cs-pop  hgt @ swap hgt !                        \ ( hT ) ; hgt := h0
  cs-push  K-ELSE cs-push ;
: do-then ( -- )    \ require the two arms to agree
  cs-empty? if  c-bad exit then
  cs-pop
  dup K-ELSE = if  drop  cs-pop hgt @ = 0= if bad-branch then  exit  then  \ else-arm vs true-arm
  dup K-IF   = if  drop  cs-pop dup hgt @ = 0= if bad-branch then hgt !  exit  then \ empty else: arm neutral
  drop  c-bad ;                                   \ `then` with no matching if/else

\ --- loops: the body must be stack-neutral per iteration ---------------------
: do-begin  ( -- )  hgt @ cs-push  K-BEGIN cs-push ;
: do-until  ( -- )  \ begin … until : `until` eats the flag; net must be neutral
  cs-empty? if  c-bad exit then
  cs-pop K-BEGIN = 0= if  c-bad exit then
  1 0 apply  cs-pop hgt @ = 0= if  bad-branch then ;
: do-while  ( -- )  \ begin … while : `while` eats the flag; keep the frame open
  cs-empty? if  c-bad exit then
  cs-pop K-BEGIN = 0= if  c-bad exit then
  1 0 apply  K-WHILE cs-push ;
: do-repeat ( -- )  \ … repeat : body must return to begin's height
  cs-empty? if  c-bad exit then
  cs-pop K-WHILE = 0= if  c-bad exit then
  cs-pop hgt @ = 0= if  bad-branch then ;
: do-do     ( -- )  2 0 apply  hgt @ cs-push  K-DO cs-push ;  \ `do` eats limit+start
: do-loop   ( -- )  \ … loop : body must be height-neutral
  cs-empty? if  c-bad exit then
  cs-pop K-DO = 0= if  c-bad exit then
  cs-pop hgt @ = 0= if  bad-branch then ;

\ --- early return: every `exit` must leave the same effect as the final `;` ----------
: cur-in  ( -- n )  lo @ negate ;
: cur-out ( -- n )  lo @ negate hgt @ + ;
: do-exit ( -- )
  nexits @ 0= if  cur-in exit-in !  cur-out exit-out !             \ first exit: remember its effect
  else  cur-in exit-in @ = 0=  cur-out exit-out @ = 0=  or  if  -1 exiterr !  then  then
  nexits @ 1+ nexits !  -1 post-exit !          \ anything before the closer is now unreachable
  cs-empty? 0= if  csp @ 16 - @  hgt !  then ;  \ this path returned: restore the enclosing frame's
                                                \ height so the pending branch/loop merge stays balanced

\ --- return-stack tracking (>r / r> / r@) ------------------------------------
: r-push  ( -- )  rdep @ 1+ rdep ! ;
: r-pop   ( -- )  rdep @ 1- dup rdep !  0 < if  -1 rerr !  then ;  \ r> below our frame
: r-fetch ( -- )  rdep @ 0 <= if  -1 rerr !  then ;               \ r@ with nothing pushed

\ --- cell-kind transfer functions --------------------------------------------
: bad-ty ( -- )  terr @ 1+ terr ! ;
: knum   ( -- )  KN kset ;        : kflag ( -- )  KF kset ;
: addr?  ( kind -- f )  KA = ;    : flag? ( kind -- f )  KF = ;
: num?   ( kind -- f )  dup KN = swap KZ = or ;    \ KZ (literal zero) is a number too
: notaddr? ( kind -- f )  dup num? swap flag? or ;     \ KNOWN non-address (num or flag)
: need-addr ( -- )  topk notaddr? if  bad-ty  then ;   \ top must be an address (or unknown)
\ shufflers: save consumed kinds, apply (height + default K?), write the permuted kinds.
: a-dup  ( -- )  topk sk0 !  1 2 apply  sk0 @ hgt @ 1- k!h  sk0 @ hgt @ 2 - k!h ;
: a-swap ( -- )  topk sk0 ! 2ndk sk1 !  2 2 apply  sk1 @ hgt @ 1- k!h  sk0 @ hgt @ 2 - k!h ;
: a-over ( -- )  topk sk0 ! 2ndk sk1 !  2 3 apply
  sk1 @ hgt @ 1- k!h  sk0 @ hgt @ 2 - k!h  sk1 @ hgt @ 3 - k!h ;
: a-rot  ( -- )  topk sk0 ! 2ndk sk1 ! hgt @ 3 - k@h sk2 !  3 3 apply
  sk2 @ hgt @ 1- k!h  sk0 @ hgt @ 2 - k!h  sk1 @ hgt @ 3 - k!h ;
: a-nip  ( -- )  topk sk0 !  2 1 apply  sk0 @ hgt @ 1- k!h ;
: a-2dup ( -- )  topk sk0 ! 2ndk sk1 !  2 4 apply
  sk0 @ hgt @ 1- k!h  sk1 @ hgt @ 2 - k!h  sk0 @ hgt @ 3 - k!h  sk1 @ hgt @ 4 - k!h ;
\ arithmetic: pointer-aware, and UNKNOWN is absorbing (an unknown operand -> unknown
\ result), so we never assert a concrete kind we'd later wrongly flag (e.g. an address
\ from a user word + an offset must stay address-ish, not become a "number" we then ty!).
: plus-kind  ( -- kind )  topk addr? 2ndk addr? or if KA exit then  topk num? 2ndk num? and if KN exit then  K? ;
: minus-kind ( -- kind )  2ndk addr? if  topk addr? if KN else KA then  exit then  topk num? 2ndk num? and if KN else K? then ;
: incr-kind  ( -- kind )  topk addr? if KA exit then  topk num? if KN else K? then ;   \ 1+ 1- cell+
: bool-kind  ( -- kind )  topk flag? 2ndk flag? and if KF exit then  topk num? 2ndk num? and if KN else K? then ;
: a-plus  ( -- )  topk addr? 2ndk addr? and if bad-ty then  plus-kind   2 1 apply  kset ;  \ addr+addr -> ty!
: a-minus ( -- )  minus-kind  2 1 apply  kset ;                          \ addr-addr -> num, addr-num -> addr
: bad-arith ( -- )  topk dup addr? swap flag? or  2ndk dup addr? swap flag? or  or if bad-ty then ;
: a-mul    ( -- )  bad-arith  2 1 apply knum ;
: a-divmod ( -- )  topk KZ = if  zerr @ 1+ zerr !  then  bad-arith  2 1 apply knum ;  \ / mod : divisor on top
: a-incr  ( -- )  incr-kind  1 1 apply  kset ;
: a-bool  ( -- )  bool-kind  2 1 apply  kset ;                           \ and/or/xor
: a-num1  ( -- )  topk num?            1 1 apply  if KN else K? then kset ;  \ 2* 2/ negate abs
: a-num2  ( -- )  topk num? 2ndk num? and  2 1 apply  if KN else K? then kset ;  \ min max lshift rshift

\ --- classify one token into the running simulation --------------------------
: classify ( -- )
  post-exit @ if                                  \ we're right after an `exit`…
    then? else? or until? or while? or repeat? or loop? or
    if  0 post-exit !                             \ a closer ends the dead region — resume normally
    else  deaderr @ 0= if -1 deaderr ! then  exit  then  \ otherwise this token is unreachable; skip it
  then
  if?     if  do-if      exit  then               \ control flow first
  else?   if  do-else    exit  then
  then?   if  do-then    exit  then
  begin?  if  do-begin   exit  then
  until?  if  do-until   exit  then
  while?  if  do-while   exit  then
  repeat? if  do-repeat  exit  then
  do?     if  do-do      exit  then
  loop?   if  do-loop    exit  then
  s" exit" tok= if  do-exit  exit  then           \ early return
  sq?   if  skip-string  0 2 apply  KA hgt @ 2 - k!h  KN kset  exit then  \ s" … " -> ( addr len )
  dotq? if  skip-string  exit then                                        \ ." … " -> ( )
  s" [char]" tok= if  read-tok  0 1 apply knum  exit then  \ these consume the FOLLOWING token,
  s" char"   tok= if  read-tok  0 1 apply knum  exit then  \ not a stack item: [char] X / char X
  s" '"      tok= if  read-tok  0 1 apply KA kset  exit then  \ ' word  -> ( cfa = address )
  s" [']"    tok= if  read-tok  0 1 apply KA kset  exit then
  s" >r" tok= if  1 0 apply  r-push   exit  then  \ return-stack words
  s" r>" tok= if  0 1 apply  r-pop    exit  then
  s" r@" tok= if  0 1 apply  r-fetch  exit  then
  t.str number if  0 1 apply  0= if KZ else KN then kset  exit  then  drop  \ literal -> number (0 -> KZ)
  s" dup"   tok= if  a-dup   exit then            \ shufflers (kind-permuting)
  s" drop"  tok= if  1 0 apply  exit then
  s" swap"  tok= if  a-swap  exit then
  s" over"  tok= if  a-over  exit then
  s" rot"   tok= if  a-rot   exit then
  s" nip"   tok= if  a-nip   exit then
  s" 2dup"  tok= if  a-2dup  exit then
  s" 2drop" tok= if  2 0 apply  exit then
  s" @"  tok= if  need-addr 1 1 apply  exit then  \ memory: need an address
  s" c@" tok= if  need-addr 1 1 apply  exit then
  s" !"  tok= if  need-addr 2 0 apply  exit then
  s" c!" tok= if  need-addr 2 0 apply  exit then
  s" +"  tok= if  a-plus   exit then              \ arithmetic
  s" -"  tok= if  a-minus  exit then
  s" *"  tok= if  a-mul     exit then
  s" /"  tok= if  a-divmod  exit then
  s" mod" tok= if a-divmod  exit then
  s" 1+" tok= if  a-incr   exit then
  s" 1-" tok= if  a-incr   exit then
  s" cell+" tok= if a-incr exit then
  s" cells" tok= if 1 1 apply knum  exit then     \ a count*8 is always a number (an offset)
  s" 2*" tok= if  a-num1  exit then
  s" 2/" tok= if  a-num1  exit then
  s" negate" tok= if a-num1  exit then
  s" abs" tok= if a-num1  exit then
  s" min" tok= if a-num2  exit then
  s" max" tok= if a-num2  exit then
  s" lshift" tok= if a-num2  exit then
  s" rshift" tok= if a-num2  exit then
  s" and" tok= if  a-bool  exit then
  s" or"  tok= if  a-bool  exit then
  s" xor" tok= if  a-bool  exit then
  s" =" tok= if  2 1 apply kflag  exit then       \ comparisons -> flag
  s" <" tok= if  2 1 apply kflag  exit then
  s" >" tok= if  2 1 apply kflag  exit then
  s" <=" tok= if 2 1 apply kflag  exit then
  s" >=" tok= if 2 1 apply kflag  exit then
  s" 0=" tok= if 1 1 apply kflag  exit then
  s" 0<" tok= if 1 1 apply kflag  exit then
  s" 0>" tok= if 1 1 apply kflag  exit then
  t.str tlookup                                   \ otherwise: a known word ( cons prod okind flag )
  if  >r apply  r>  dup K? = if drop else kset then  \ apply height, then set top to its out-kind
  else  2drop drop  t.str unk!  then ;             \ or unknown (record by name)

\ --- finalize + reports ------------------------------------------------------
: finalize ( -- )                                \ end-of-phrase consistency checks
  rdep @ if  -1 rerr !  then                      \ leftover items on the return stack
  cs-empty? 0= if  c-bad  then ;                  \ an unclosed if / begin / do
: .unknowns ( -- )
  unk @ 0= if  exit  then
  [char] ? emit space
  unkbase @ ui !
  begin  ui @ unkp @ <  while
    ui @ @  ui @ 8 + @  type space                \ name-ptr, len
    ui @ 16 + ui !
  repeat  cr ;
: .imb  ( -- )  imb  @  if  s" br!"  type cr  then ;
: .ctl  ( -- )  cerr @  if  s" ctl!" type cr  then ;
: .rerr ( -- )  rerr @  if  s" r!"   type cr  then ;
: .tyy  ( -- )  terr @  if  s" ty!"  type cr  then ;
: .zero ( -- )  zerr @  if  s" /0!"  type cr  then ;
: .ex   ( -- )  exiterr @ if  s" ex!"  type cr  then ;
: .dc   ( -- )  deaderr @ if  s" dc!"  type cr  then ;
: .flags ( -- )  .unknowns  .imb  .ctl  .rerr  .tyy  .zero  .ex  .dc ;
: clean? ( -- f )  unk @ 0=  imb @ 0= and  cerr @ 0= and  rerr @ 0= and
                   terr @ 0= and  zerr @ 0= and  exiterr @ 0= and  deaderr @ 0= and ;

: report ( -- )                                  \ for check{
  finalize
  lo @ negate   lo @ negate hgt @ +   .eff
  .flags ;

: okmsg  ( -- )  s" ok" type cr ;
: badmsg ( -- )  s" BAD " type din @ dout @ .eff ;
: report-def ( -- )
  finalize
  name-a @ name-n @ type space
  cons-i @ prod-i @ .eff
  has-decl @  if
    dok @ K? = 0=  iok @ K? = 0=  and             \ both output kinds known, and exactly one is an
    dok @ addr? iok @ addr? = 0=  and  if  bad-ty  then  \ address -> returns wrong kind (num/flag are
    cons-i @ din @ =  prod-i @ dout @ =  and  if    \ interchangeable, so only address mismatches flag)
      clean? if  okmsg  then                          \ …and nothing else complained -> ok
    else  badmsg  then                                \ arity disagrees -> BAD (the headline)
  then
  .flags ;                                            \ ? / br! / ctl! / r! / ty! explain the rest

\ --- the two entry points ----------------------------------------------------
: reset-sim ( -- )
  0 hgt !  0 lo !  0 unk !  0 imb !  0 cerr !  0 rerr !  0 rdep !  0 terr !  0 zerr !
  0 exiterr !  0 nexits !  0 post-exit !  0 deaderr !
  csbase @ csp !  unkbase @ unkp !  a-clear ;
: check{ ( -- )           \ check{ <words> }
  reset-sim
  begin  read-tok  end? 0=  while  classify  repeat
  report ;

variable dinkbuf 64 cells allot  variable dki    \ declared input kinds, in order
: decl-kind ( -- kind )   \ classify a declared input name into a cell kind
  s" addr" tok= if  KA exit then
  s" adr"  tok= if  KA exit then
  s" ptr"  tok= if  KA exit then
  s" n"    tok= if  KN exit then
  s" u"    tok= if  KN exit then
  s" flag" tok= if  KF exit then
  K? ;
: parse-decl ( -- )       \ called just after reading '(' ; counts in/out, seeds in/out kinds
  -1 has-decl !  0 din !  0 dout !  0 dki !  K? dok !
  begin  read-tok  dd? 0=  while
    decl-kind  dinkbuf dki @ cells + !  dki @ 1+ dki !  din @ 1+ din !  repeat
  begin  read-tok  rp? 0=  while  decl-kind dok !  dout @ 1+ dout !  repeat  \ dok = top output's kind
  0 dki !                                          \ place input kinds below entry: token j -> height j-din
  begin  dki @ din @ <  while
    dinkbuf dki @ cells + @   dki @ din @ -  k!h  dki @ 1+ dki !  repeat ;

: pre-register ( -- )     \ register the DECLARED effect (incl. out-kind) before the body
  tp @ def-entry !
  0 name-a @ name-n @ din @ dout @ dok @ register ;
: finish-register ( -- )  \ overwrite the pre-registered effect with the inferred arity (keep dok)
  cons-i @ def-entry @ 24 + !   prod-i @ def-entry @ 32 + ! ;

: def ( -- )              \ def name [ ( in -- out ) ] body ;
  read-tok  tok-n @ name-n !                       \ copy the name out of wordbuf (later
  tok-a @ tok-n @ copy-name name-a !               \ read-toks overwrite it) so reports show it
  reset-sim  0 has-decl !
  read-tok  lp? if  parse-decl  read-tok  then
  has-decl @ if  pre-register  then                \ recursion: declared self-effect
  begin  semi? 0=  while  classify  read-tok  repeat
  lo @ negate cons-i !  cons-i @ hgt @ + prod-i !  topk iok !   \ inferred top-output kind
  nexits @ if  cons-i @ exit-in @ = 0=  prod-i @ exit-out @ = 0=  or  if -1 exiterr ! then  then
  has-decl @ if  finish-register                   \ keeps the declared out-kind for callers
  else  0 name-a @ name-n @ cons-i @ prod-i @ iok @ register  then  \ no decl: advertise inferred
  report-def ;

\ --- the primitive effect table ( consumes produces prim <name> ) ------------
\ Mirrors the kernel + prelude. Words not loaded register by name (CFA 0) — fine,
\ since def/check{ look up by name; only the CFA path (forge's check-body) needs CFAs.
\ stack shufflers
1 2 prim dup      1 0 prim drop     2 2 prim swap     2 3 prim over
3 3 prim rot      2 1 prim nip      2 4 prim 2dup     2 0 prim 2drop
\ arithmetic / logic
2 1 prim +        2 1 prim -        2 1 prim *        2 1 prim /
2 1 prim mod      1 1 prim negate   1 1 prim 1+       1 1 prim 1-
1 1 prim abs      1 1 prim 2*       1 1 prim 2/       2 1 prim min
2 1 prim max      2 1 prim and      2 1 prim or       2 1 prim xor
2 1 prim lshift   2 1 prim rshift
\ comparisons (all leave one flag)
2 1 prim =        2 1 prim <        2 1 prim >        2 1 prim <=
2 1 prim >=       1 1 prim 0=       1 1 prim 0<       1 1 prim 0>
\ memory + strings
1 1 prim @        2 0 prim !        1 1 prim c@       2 0 prim c!
1 0 prim ,        1 1 prim cells    1 1 prim cell+
2 0 prim type     3 0 prim cmove    3 0 prim fill     1 2 prim count    1 0 prim spaces
\ return-stack words (classify special-cases these too, for r-balance)
1 0 prim >r       0 1 prim r>       0 1 prim r@
\ counted-loop helpers
0 1 prim i        0 1 prim j        0 0 prim unloop
\ i/o + misc
1 0 prim emit     0 1 prim key      1 0 prim .        1 0 prim u.
0 1 prim depth    0 0 prim space    0 0 prim cr       0 0 prim bye
0 1 prim here     1 0 prim allot    1 1 prim square

\ --- recognize `variable` / `constant` so anvil can check STATEFUL code -----------
\ These shadow the kernel words while anvil is loaded (anvil's own internals are already
\ compiled above): `variable counter` or `5 constant LIMIT` makes the real word *and* registers
\ the name with effect ( -- x ), so a word that uses it is checked instead of flagged
\ `? counter`. We stash the kernel CFAs first and `execute` them — fr makes a word self-visible
\ during its own definition, so `: variable variable … ;` would recurse forever. After the
\ kernel word runs it's `latest`, so we read its name from the dictionary header to register it.
' variable  constant kvar
' constant  constant kconst
: reg-latest ( okind -- )  >r  0  latest 9 +  latest 8 + c@ 127 and  0 1  r>  register ;  \ name from newest header
: variable ( -- )         kvar   execute  KA reg-latest ;   \ a variable's name pushes its ADDRESS
: constant ( n -- )       kconst execute  K? reg-latest ;   \ a constant's value kind is unknown
