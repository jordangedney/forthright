def hex_to_xterm256(h):
    """Map #rrggbb to the nearest xterm-256 colour index."""
    h = h.lstrip("#")
    r, g, b = int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)
    levels = [0, 95, 135, 175, 215, 255]

    def nearest(v):
        return min(range(6), key=lambda i: abs(levels[i] - v))
    ri, gi, bi = nearest(r), nearest(g), nearest(b)
    cube = 16 + 36 * ri + 6 * gi + bi
    # also consider the grayscale ramp for near-gray colours
    gray = round((r + g + b) / 3)
    gidx = 232 + min(23, max(0, round((gray - 8) / 10)))
    cr, cg, cb = levels[ri], levels[gi], levels[bi]
    gv = 8 + 10 * (gidx - 232)
    d_cube = (cr - r) ** 2 + (cg - g) ** 2 + (cb - b) ** 2
    d_gray = (gv - r) ** 2 + (gv - g) ** 2 + (gv - b) ** 2
    return cube if d_cube <= d_gray else gidx


class UI:
    def __init__(self, stdscr, vm):
        self.scr = stdscr
        self.vm = vm
        self.native = getattr(vm, "native", False)
        self.input = ""
        self.mode = "edit"          # "edit" | "run"
        self.auto = False
        self.speed = 220            # ms per auto step
        self.cur = 0                # blink phase
        self._init_colors()
        self.vm.log("ember ready.  type Forth below, e.g.  5 square .")
        self.vm.log("define words with  : name ... ;   then step through them.")

    def _init_colors(self):
        curses.start_color()
        try:
            curses.use_default_colors()
        except curses.error:
            pass
        self.cidx = {k: hex_to_xterm256(v) for k, v in PALETTE.items()}
        self.bg = self.cidx["bg"]
        self.pair = {}
        order = ["text", "text_mid", "text_dim", "ip", "stack", "hop",
                 "exec", "ok", "red", "frost", "border", "border_hi", "panel"]
        for n, key in enumerate(order, start=1):
            try:
                curses.init_pair(n, self.cidx[key], self.bg)
            except curses.error:
                curses.init_pair(n, curses.COLOR_WHITE, -1)
            self.pair[key] = curses.color_pair(n)
        try:
            self.scr.bkgd(" ", self.pair["text"])
        except curses.error:
            pass

    def C(self, key, extra=0):
        return self.pair.get(key, 0) | extra

    # ---- safe drawing ---------------------------------------------------
    def put(self, y, x, text, attr=0):
        h, w = self.scr.getmaxyx()
        if y < 0 or y >= h:
            return
        if x < 0:
            text = text[-x:]; x = 0
        if x >= w:
            return
        text = text[: w - x]
        try:
            self.scr.addstr(y, x, text, attr)
        except curses.error:
            pass

    def box(self, y, x, h, w, title, tcolor="border", title_attr=None):
        c = self.C("border")
        self.put(y, x, "┌" + "─" * (w - 2) + "┐", c)
        for r in range(1, h - 1):
            self.put(y + r, x, "│", c)
            self.put(y + r, x + w - 1, "│", c)
        self.put(y + h - 1, x, "└" + "─" * (w - 2) + "┘", c)
        if title:
            label = "─ " + title + " "
            self.put(y, x + 2, label, self.C(tcolor, title_attr or curses.A_BOLD))

    # ---- the render -----------------------------------------------------
    def draw(self):
        self.scr.erase()
        H, W = self.scr.getmaxyx()
        if H < 20 or W < 76:
            self.put(0, 0, "ember needs at least 76x20. Resize the terminal.",
                     self.C("red"))
            self.scr.refresh()
            return

        # title bar
        self.put(0, 1, "ember", self.C("frost", curses.A_BOLD))
        self.put(0, 7, "· forthright threaded-code explorer", self.C("text_dim"))
        st = self.vm
        rstate = ("HALTED" if st.halted else ("AUTO" if self.auto else "STEP")) \
            if self.mode == "run" else "EDIT"
        scol = "red" if st.error else ("ok" if st.halted else "exec")
        self.put(0, W - len(rstate) - 2, rstate, self.C(scol, curses.A_BOLD))

        right_w = 30
        left_x = 1
        left_w = W - right_w - 3
        right_x = left_x + left_w + 1
        top = 2
        input_h = 3
        bottom = H - input_h - 1            # row of status line
        main_h = bottom - top

        out_h = max(6, main_h // 3)
        thread_h = main_h - out_h
        self._draw_thread(top, left_x, thread_h, left_w)
        self._draw_output(top + thread_h, left_x, out_h, left_w)

        data_h = max(7, main_h * 2 // 5)
        ret_h = max(5, (main_h - data_h) // 2)
        dict_h = main_h - data_h - ret_h
        self._draw_data(top, right_x, data_h, right_w)
        self._draw_return(top + data_h, right_x, ret_h, right_w)
        self._draw_dict(top + data_h + ret_h, right_x, dict_h, right_w)

        self._draw_input(bottom - input_h + 1, left_x, input_h, W - 2)
        self._draw_status(H - 1, W)
        self.scr.refresh()

    def _cell_label(self, body, idx):
        cell = body[idx]
        if cell is self.vm.LIT:
            return "lit", "exec"
        if isinstance(cell, int):
            # a literal value (after LIT) or a raw data cell (e.g. branch offset)
            after_lit = idx > 0 and body[idx - 1] is self.vm.LIT
            return str(cell), ("stack" if after_lit else "text_dim")
        kind = getattr(cell, "kind", "")
        if kind == "exit":
            return "exit", "hop"
        if kind == "lit":
            return "lit", "exec"
        if kind == "colon":
            return getattr(cell, "name", "?"), "frost"   # a hop target
        return getattr(cell, "name", "?"), "text"

    def _draw_thread(self, y, x, h, w):
        vm = self.vm
        word = vm.frame[0] if vm.frame else None
        ip = vm.frame[1] if vm.frame else -1
        cur_color = "ip" if self.native else "exec"
        if self.native and getattr(vm, "exec_name", ""):
            title = "IP in %s  ▶ %s" % (word.name if word else "?", vm.exec_name)
        else:
            title = "THREAD: %s" % (word.name if word else "(none)")
        self.box(y, x, h, w, title, "ip")
        if not word:
            self.put(y + 1, x + 2, "enter a line below to load a thread",
                     self.C("text_dim"))
            return
        body = word.body
        rows = h - 2
        # scroll so ip stays visible
        start = 0
        if len(body) > rows:
            start = max(0, min(ip - rows // 2, len(body) - rows))
        for r in range(rows):
            idx = start + r
            if idx >= len(body):
                break
            label, col = self._cell_label(body, idx)
            ry = y + 1 + r
            current = (idx == ip and not vm.halted)
            executed = idx < ip
            addr = "%2d" % idx
            if current:
                mark = "▸" if (self.cur % 2 == 0 or not self.auto) else " "
                attr = self.C(cur_color, curses.A_BOLD | curses.A_REVERSE)
                self.put(ry, x + 1, mark, self.C(cur_color, curses.A_BOLD))
                self.put(ry, x + 3, addr, self.C(cur_color))
                self.put(ry, x + 6, " " + label.ljust(w - 9), attr)
            else:
                acol = "text_dim" if executed else col
                aattr = curses.A_DIM if executed else 0
                self.put(ry, x + 3, addr, self.C("text_dim"))
                self.put(ry, x + 6, " " + label, self.C(acol, aattr))

    def _draw_data(self, y, x, h, w):
        vm = self.vm
        pulse = "stack" in vm.pulse
        self.box(y, x, h, w, "DATA  (%d)" % len(vm.dstack), "stack")
        rows = h - 2
        ds = vm.dstack
        shown = ds[-rows:] if len(ds) > rows else ds
        # top of stack at the top of the panel
        for r, val in enumerate(reversed(shown)):
            ry = y + 1 + r
            is_top = (r == 0)
            if is_top:
                attr = self.C("stack", curses.A_BOLD | (curses.A_REVERSE if pulse else 0))
                self.put(ry, x + 2, ("%-*s top" % (w - 8, str(val))), attr)
            else:
                self.put(ry, x + 2, str(val), self.C("text_mid"))
        if not ds:
            self.put(y + 1, x + 2, "(empty)", self.C("text_dim"))

    def _draw_return(self, y, x, h, w):
        vm = self.vm
        pulse = "hop" in vm.pulse
        self.box(y, x, h, w, "RETURN (%d)" % len(vm.rstack), "hop")
        rows = h - 2
        frames = vm.rstack[-rows:]
        for r, (wd, ip) in enumerate(reversed(frames)):
            attr = self.C("hop", curses.A_BOLD if (pulse and r == 0) else 0)
            self.put(y + 1 + r, x + 2, "%s @%d" % (wd.name, ip), attr)
        if not vm.rstack:
            self.put(y + 1, x + 2, "(empty)", self.C("text_dim"))

    def _draw_dict(self, y, x, h, w):
        vm = self.vm
        self.box(y, x, h, w, "DICTIONARY", "frost")
        names = []
        for wd in vm.words:
            if wd.kind == "colon":
                names.append((wd.name, "frost"))
            else:
                names.append((wd.name, "text_dim"))
        # pack names into rows
        rows = h - 2
        line = ""
        ry = y + 1
        col_attr = []
        # simple flow layout
        cx = x + 2
        maxx = x + w - 1
        for nm, col in names:
            if cx + len(nm) + 1 > maxx:
                ry += 1; cx = x + 2
                if ry >= y + 1 + rows:
                    break
            self.put(ry, cx, nm, self.C(col))
            cx += len(nm) + 1

    def _draw_output(self, y, x, h, w):
        self.box(y, x, h, w, "OUTPUT", "ok")
        rows = h - 2
        lines = self.vm.output[-rows:]
        for r, ln in enumerate(lines):
            col = "red" if ln.startswith("✗") else (
                "ok" if ln.startswith("✓") else "text_mid")
            self.put(y + 1 + r, x + 2, ln[: w - 4], self.C(col))

    def _draw_input(self, y, x, h, w):
        self.box(y, x, h, w, "input", "exec" if self.mode == "edit" else "border")
        prompt = "ok> " if self.mode == "edit" else "... "
        self.put(y + 1, x + 2, prompt, self.C("ok", curses.A_BOLD))
        text = self.input
        self.put(y + 1, x + 6, text, self.C("text"))
        if self.mode == "edit":
            cur = "█" if self.cur % 2 == 0 else " "
            self.put(y + 1, x + 6 + len(text), cur, self.C("ip", curses.A_BOLD))

    def _draw_status(self, y, W):
        if self.mode == "edit":
            keys = "  Enter run/define   bye quit   Esc/^D exit   "
        else:
            keys = "  s step   a auto(%dms)   r run   n new   q quit   " % self.speed
        self.put(y, 0, keys.ljust(48), self.C("text_dim"))
        # legend
        lx = max(48, W - 40)
        for label, col in [("ip", "ip"), ("stack", "stack"),
                           ("hop", "hop"), ("exec", "exec")]:
            self.put(y, lx, "●", self.C(col, curses.A_BOLD))
            self.put(y, lx + 1, label + " ", self.C("text_dim"))
            lx += len(label) + 3

    # ---- input handling -------------------------------------------------
    def submit(self):
        line = self.input.strip()
        self.input = ""
        if not line:
            return
        self.vm.log("ok> " + line)
        kind, w = self.vm.feed(line)
        if kind == "run":
            self.mode = "run"
            self.auto = False
        elif kind == "err":
            self.vm.log("✗ " + w)

    def finish_run(self):
        self.vm.run()                      # complete anything left
        self.mode = "edit"
        self.auto = False
        self.vm.frame = None
        self.vm.halted = True

    def handle_key(self, ch):
        if ch in (curses.KEY_RESIZE,):
            return
        if ch == 4:                          # Ctrl-D quits anywhere
            self.vm.quit = True
            return
        if self.mode == "edit":
            if ch in (curses.KEY_ENTER, 10, 13):
                self.submit()
            elif ch in (curses.KEY_BACKSPACE, 127, 8):
                self.input = self.input[:-1]
            elif ch == 27:                  # Esc: clear the line, or quit if empty
                if self.input:
                    self.input = ""
                else:
                    self.vm.quit = True
            elif 32 <= ch < 127:
                self.input += chr(ch)
        else:  # run mode
            if ch in (ord("s"), ord(" "), curses.KEY_RIGHT):
                if not self.vm.halted:
                    self.vm.step()
            elif ch == ord("a"):
                self.auto = not self.auto
            elif ch == ord("r"):
                self.vm.run()
            elif ch in (ord("n"), 27, curses.KEY_ENTER, 10, 13):
                self.finish_run()
            elif ch == ord("q"):
                self.vm.quit = True
            elif ch in (ord("+"), ord("=")):
                self.speed = max(40, self.speed - 40)
            elif ch in (ord("-"), ord("_")):
                self.speed = min(1000, self.speed + 40)

    def loop(self):
        while True:
            self.draw()
            if self.vm.quit:
                return
            if self.mode == "run" and self.auto and not self.vm.halted:
                self.scr.timeout(self.speed)
            else:
                self.scr.timeout(400 if self.mode == "edit" else -1)
            ch = self.scr.getch()
            self.cur += 1
            if ch == -1:                    # timeout tick
                if self.mode == "run" and self.auto and not self.vm.halted:
                    self.vm.step()
                continue
            self.handle_key(ch)


def fr_path():
    return os.path.join(os.path.dirname(os.path.abspath(__file__)), "fr")


def native_selftest():
    frpath = fr_path()
    if not os.path.exists(frpath):
        print("no ./fr binary — run ./build.sh first"); return 1
    vm = NativeVM(frpath)
    print("booted: state=%s pid=%d" % (vm.state, vm.pid))
    vm.feed("5 square .")
    seen, guard = [], 0
    while not vm.halted and guard < 4000:
        seen.append((vm.exec_name, list(vm.dstack)))
        vm.step(); guard += 1
    print("dispatched:", " ".join(s[0] for s in seen if s[0])[:200])
    saw_25_with_5 = any(ds == [5] for _, ds in seen) and any(ds == [25] for _, ds in seen)
    print("saw stack 5 then 25:", saw_25_with_5)
    print("output:", vm.output[-4:])
    vm.feed(": cube dup dup * * ;"); vm.run()
    vm.feed("4 cube ."); vm.run()
    print("after cube:", vm.output[-3:])
    dict_names = [w.name for w in vm.words]
    print("dict has cube:", "cube" in dict_names)
    ok = (any(o == "25" for o in vm.output) and any(o == "64" for o in vm.output)
          and "cube" in dict_names and saw_25_with_5)
    print("\nNATIVE %s" % ("PASS" if ok else "FAIL"))
    return 0 if ok else 1


def run_ui(stdscr, make_vm):
    curses.curs_set(0)
    ui = UI(stdscr, make_vm())
    ui.loop()


def main():
    if "--selftest" in sys.argv:
        sys.exit(selftest())
    if "--native-selftest" in sys.argv:
        sys.exit(native_selftest())

    frpath = fr_path()
    want_native = ("--python" not in sys.argv and os.path.exists(frpath)
                   and sys.platform.startswith("linux"))

    def make_vm():
        if want_native:
            try:
                return NativeVM(frpath)
            except Exception as e:
                v = VM(); v.log("native unavailable (%s) — using Python model" % e)
                return v
        return VM()

    try:
        curses.wrapper(lambda s: run_ui(s, make_vm))
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
