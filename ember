#!/usr/bin/env python3
"""
ember — a threaded-code explorer for forthright.

A terminal UI that single-steps fr's indirect-threaded-code engine: watch the IP
walk a thread, watch values land on the data stack, and watch docol/EXIT hop in
and out of colon words. By default it drives the real ./fr binary under ptrace
(class NativeVM); --python swaps in a pure-Python model (class VM).

Either backend is exercised headlessly:
    python3 ember --selftest          # Python model
    python3 ember --native-selftest   # real ./fr under ptrace

Style mirrors ~/downloads/index.html (the "NEXT-runner" design): Nord palette and
the same colour coding — ip (cyan), stack (orange), hop (purple), exec (yellow).
"""

import os
import sys
import struct
import curses

